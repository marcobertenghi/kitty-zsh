# Copy to your Kitty config directory as kitty.local.conf; never installed automatically.
# font_size 18
# background_opacity 1.0
# Restore the OS titlebar and window frame (restart Kitty):
# hide_window_decorations no
# window_padding_width 8
# Disable the golden cursor trail:
# cursor_trail 0
# Use equal-width columns instead of the default 60/40 Tall layout:
# enabled_layouts tall:bias=50;full_size=1,splits,stack,grid
# map ctrl+alt+enter launch --location=vsplit --cwd=current
